# NHPLUG (모의투자부터 시작)
NHPLUG_BASE_URL=https://moapi.nhplug.com:8443
NHPLUG_AUTH_URL=https://api.nhplug.com:8443

# API1 (사용자 1)
NHPLUG_APP_KEY_1=
NHPLUG_APP_SECRET_1=
NH_ACCOUNT_1=

# API2 (사용자 2)
NHPLUG_APP_KEY_2=
NHPLUG_APP_SECRET_2=
NH_ACCOUNT_2=

# 실제 주문 실행 여부 (기본 true = nhplug.call() 실행 안 함)
NH_DRY_RUN=true
